{
  "compilerOptions": {
    "target": "ES2020",
    // CommonJS rather than ES modules: the engine evaluates this as a plain
    // script, and there is nothing on the other side to import from. What
    // little `exports` scaffolding this emits is answered by the wrapper the
    // embedding tool puts round it.
    "module": "commonjs",
    "strict": true,
    "lib": ["ES2020"],
    "noEmit": false,
    "outDir": "../build/js",

    // JSX compiles to this library's own `h`, not to React's
    // `createElement` — there is no React here and nothing to install. A tag
    // that is a string is an element the engine draws; one that is a function
    // is a component, and calling it is all that rendering one means.
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment"
  },
  "include": ["*.ts", "*.tsx"]
}
