{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "lib": ["ES2020"],
    "outDir": "../test/js",

    // The automatic runtime: no import in any file, which is what anybody who
    // has written TypeScript lately expects. `jsxImportSource` resolves
    // `<source>/jsx-runtime`, and the path mapping is what points that at this
    // library rather than at a package in node_modules.
    "jsx": "react-jsx",
    "jsxImportSource": "orbis",
    "baseUrl": ".",
    "paths": { "orbis/jsx-runtime": ["../js/jsx-runtime"] }
  },
  "include": ["*.tsx", "../js/jsx.d.ts"]
}
